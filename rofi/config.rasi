configuration {
    modi: "window,run,drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Applications:";
    display-window: "Windows:";
}

* {
    font: "Iosevka Nerd Font 16";
    background-color: transparent;
    text-color: #6C6C6D;

    margin: 4px;
    padding: 4px;
    spacing: 6px;
}

@theme "~/.config/rofi/tokyonight.rasi"
